{
    "name": "arenas-ui-workspace",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@12.22.0",
    "engines": {
        "node": "^26.13.1"
    },
    "scripts": {
        "build": "pnpm build:ui && pnpm build:playground",
        "build:ui": "pnpm --filter @arenasesteban/ui build",
        "build:playground": "pnpm --filter @arenasesteban/playground build",
        "typecheck": "pnpm --filter @arenasesteban/ui typecheck && pnpm --filter @arenasesteban/playground check",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:contracts": "pnpm --filter @arenasesteban/ui test:contracts",
        "test:browser": "pnpm --filter @arenasesteban/playground test:browser",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:contracts && pnpm test:browser"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint": "10.15.0",
        "prettier": "3.10.1",
        "prettier-plugin-astro": "^1.1.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0"
    }
}
