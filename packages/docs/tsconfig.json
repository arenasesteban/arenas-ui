{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node", "vite/client"]
    },
    "include": [".storybook/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
