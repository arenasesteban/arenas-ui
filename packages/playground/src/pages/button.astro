---
import {
    IconAlertTriangle,
    IconCheck,
    IconMenu2,
    IconPlus,
    IconTrash,
    IconX,
} from '@tabler/icons-astro';

import '../styles/global.css';

const themes = [
    { id: 'light', title: 'Light theme' },
    { id: 'dark', title: 'Dark theme' },
] as const;

const roles = [
    { label: 'Primary', className: '' },
    { label: 'Secondary', className: 'btn-secondary' },
    { label: 'Success', className: 'btn-success' },
    { label: 'Warning', className: 'btn-warning' },
    { label: 'Error', className: 'btn-error' },
] as const;

const variants = [
    { label: 'Default', className: '' },
    { label: 'Outline', className: 'btn-outline' },
    { label: 'Ghost', className: 'btn-ghost' },
    { label: 'Smooth', className: 'btn-smooth' },
] as const;

const sizes = [
    { label: 'Small', className: 'btn btn-sm' },
    { label: 'Medium', className: 'btn btn-md' },
    { label: 'Large', className: 'btn btn-lg' },
] as const;

const stateRoles = [
    { label: 'Primary', className: '' },
    { label: 'Success', className: 'btn-success' },
] as const;

const radiusExamples = [
    { label: 'Default · 10 px', value: undefined },
    { label: 'Override · 8 px', value: '0.5rem' },
] as const;

const fontExamples = [
    { label: 'System UI', family: 'system-ui, sans-serif' },
    { label: 'Arial', family: 'Arial, sans-serif' },
] as const;
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Button Review — Arenas UI</title>
    </head>

    <body>
        <main class="review">
            <header class="review-header">
                <h1>Arenas UI — Button Review</h1>
                <p>Revisión visual · Jerarquía, geometría y estados</p>
            </header>

            <div class="themes">
                {themes.map((theme) => (
                    <section class="theme" data-theme={theme.id}>
                        <h2>{theme.title}</h2>

                        <!-- Variants and semantic roles -->
                        <section class="review-section">
                            <h3>Variants and semantic colors</h3>

                            <p class="description">
                                Cuatro presentaciones con cinco roles de color. Primary y Secondary
                                tienen jerarquías distintas.
                            </p>

                            <div class="variant-matrix">
                                {roles.map((role) => (
                                    <div class="variant-group">
                                        <h4>{role.label}</h4>

                                        <div class="variant-buttons">
                                            {variants.map((variant) => (
                                                <button
                                                    type="button"
                                                    class={`btn ${role.className} ${variant.className}`.trim()}
                                                >
                                                    {variant.label}
                                                </button>
                                            ))}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </section>

                        <!-- Sizes -->
                        <section class="review-section">
                            <h3>Sizes</h3>

                            <div class="samples">
                                {sizes.map((size) => (
                                    <button type="button" class={size.className}>
                                        {size.label}
                                    </button>
                                ))}
                            </div>
                        </section>

                        <!-- Shapes -->
                        <section class="review-section">
                            <h3>Shapes</h3>

                            <div class="samples">
                                <button type="button" class="btn">
                                    Regular
                                </button>

                                <button type="button" class="btn btn-pill">
                                    Rounded
                                </button>

                                <button
                                    type="button"
                                    class="btn btn-square"
                                    aria-label="Abrir menú"
                                >
                                    <IconMenu2 size={18} stroke={1.8} aria-hidden="true" />
                                </button>

                                <button type="button" class="btn btn-circle" aria-label="Cerrar">
                                    <IconX size={18} stroke={1.8} aria-hidden="true" />
                                </button>
                            </div>
                        </section>

                        <!-- Disabled and processing -->
                        <section class="review-section">
                            <h3>States</h3>

                            <p class="description">
                                Disabled utiliza colores neutrales. Processing conserva la
                                apariencia de la variante, incluso con disabled.
                            </p>

                            {stateRoles.map((role) => (
                                <div class="state-group">
                                    <h4>{role.label}</h4>

                                    {variants.map((variant) => {
                                        const buttonClass =
                                            `btn ${role.className} ${variant.className}`.trim();

                                        return (
                                            <div class="state-row">
                                                <span class="state-name">{variant.label}</span>

                                                <div class="state-item">
                                                    <span>Enabled</span>
                                                    <button type="button" class={buttonClass}>
                                                        Action
                                                    </button>
                                                </div>

                                                <div class="state-item">
                                                    <span>Disabled</span>
                                                    <button
                                                        type="button"
                                                        class={buttonClass}
                                                        disabled
                                                    >
                                                        Action
                                                    </button>
                                                </div>

                                                <div class="state-item">
                                                    <span>Processing</span>
                                                    <button
                                                        type="button"
                                                        class={buttonClass}
                                                        disabled
                                                        aria-busy="true"
                                                    >
                                                        <span
                                                            class="loading loading-spinner"
                                                            aria-hidden="true"
                                                        ></span>
                                                        Processing
                                                    </button>
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                            ))}
                        </section>

                        <!-- Loading -->
                        <section class="review-section">
                            <h3>Loading indicator</h3>

                            <div class="samples">
                                <span
                                    class="loading loading-spinner"
                                    role="status"
                                    aria-label="Cargando"
                                ></span>

                                <button
                                    type="button"
                                    class="btn btn-outline"
                                    disabled
                                    aria-busy="true"
                                >
                                    <span class="loading loading-spinner" aria-hidden="true"></span>
                                    Procesando...
                                </button>
                            </div>
                        </section>

                        <!-- Tabler icons -->
                        <section class="review-section">
                            <h3>Buttons with icons</h3>

                            <div class="samples">
                                <button type="button" class="btn btn-success">
                                    <IconCheck size={18} stroke={1.8} aria-hidden="true" />
                                    Confirmar
                                </button>

                                <button type="button" class="btn btn-warning btn-smooth">
                                    <IconAlertTriangle size={18} stroke={1.8} aria-hidden="true" />
                                    Advertencia
                                </button>

                                <button type="button" class="btn btn-error btn-outline">
                                    <IconTrash size={18} stroke={1.8} aria-hidden="true" />
                                    Eliminar
                                </button>

                                <button type="button" class="btn btn-pill">
                                    <IconPlus size={18} stroke={1.8} aria-hidden="true" />
                                    Agregar
                                </button>
                            </div>
                        </section>

                        <!-- Geometry -->
                        <section class="review-section">
                            <h3>Geometry</h3>

                            <p class="description">
                                Radio regular de 10 px y ejemplo de personalización mediante token.
                            </p>

                            <div class="comparison">
                                {radiusExamples.map((radius) => (
                                    <div class="comparison-item">
                                        <h4>{radius.label}</h4>

                                        <div class="samples">
                                            {sizes.map((size) => (
                                                <button
                                                    type="button"
                                                    class={size.className}
                                                    style={
                                                        radius.value
                                                            ? `--aui-radius-control: ${radius.value}`
                                                            : undefined
                                                    }
                                                >
                                                    {size.label}
                                                </button>
                                            ))}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </section>

                        <!-- Typography -->
                        <section class="review-section">
                            <h3>Typography</h3>

                            <div class="comparison">
                                {fontExamples.map((font) => (
                                    <div
                                        class="comparison-item"
                                        style={`font-family: ${font.family}`}
                                    >
                                        <h4>{font.label}</h4>

                                        <button type="button" class="btn">
                                            Continue
                                        </button>
                                    </div>
                                ))}
                            </div>
                        </section>

                        <!-- Tailwind interoperability -->
                        <section class="review-section">
                            <h3>Customization and layout</h3>

                            <div class="samples">
                                <button
                                    type="button"
                                    class="btn bg-blue-800 text-white px-8 rounded-none"
                                >
                                    Utility override
                                </button>

                                <a href="#destination" class="btn btn-outline">
                                    Styled link
                                </a>
                            </div>

                            <div class="block-example">
                                <button type="button" class="btn btn-block">
                                    Block button
                                </button>
                            </div>
                        </section>

                        <!-- Composition -->
                        <section class="review-section">
                            <h3>Action hierarchy</h3>

                            <div class="scenario">
                                <h4>¿Guardar los cambios?</h4>
                                <p>
                                    Primary destaca y Secondary acompaña sin competir por atención.
                                </p>

                                <div class="scenario-actions">
                                    <button type="button" class="btn btn-secondary">
                                        Cancelar
                                    </button>

                                    <button type="button" class="btn">
                                        Guardar cambios
                                    </button>
                                </div>
                            </div>
                        </section>

                        <section class="review-section">
                            <h3>Semantic actions</h3>

                            <div class="scenario">
                                <h4>Gestión de elementos</h4>
                                <p>Acciones generales, confirmación y eliminación.</p>

                                <div class="scenario-actions">
                                    <button type="button" class="btn">
                                        Editar
                                    </button>

                                    <button type="button" class="btn btn-success btn-smooth">
                                        <IconCheck size={18} stroke={1.8} aria-hidden="true" />
                                        Confirmar
                                    </button>

                                    <button type="button" class="btn btn-error btn-ghost">
                                        <IconTrash size={18} stroke={1.8} aria-hidden="true" />
                                        Eliminar
                                    </button>
                                </div>
                            </div>
                        </section>
                    </section>
                ))}
            </div>

            <div id="destination"></div>
        </main>
    </body>
</html>

<style>
    body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background: #f4f4f5;
    }

    .review {
        max-width: 1440px;
        margin: 0 auto;
        padding: 32px 20px;
    }

    .review-header {
        margin-bottom: 28px;
    }

    .review-header h1 {
        margin: 0 0 8px;
        font-size: 28px;
        font-weight: 700;
    }

    .review-header p {
        margin: 0;
        color: #52525b;
    }

    /* Theme panels */

    .themes {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .theme {
        display: flex;
        flex-direction: column;
        gap: 28px;
        min-width: 0;
        padding: 28px;
        border-radius: 12px;
        background: var(--aui-color-surface);
        color: var(--aui-color-text);
    }

    .theme h2 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
    }

    /* Sections */

    .review-section h3 {
        margin: 0 0 12px;
        font-size: 14px;
        font-weight: 600;
    }

    .review-section h4 {
        margin: 0 0 12px;
        font-size: 13px;
        font-weight: 600;
    }

    .description {
        margin: 0 0 14px;
        font-size: 13px;
        line-height: 1.5;
        opacity: 0.72;
    }

    .samples,
    .variant-buttons {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
    }

    /* Variant matrix */

    .variant-matrix {
        display: grid;
        gap: 18px;
    }

    .variant-group {
        display: grid;
        gap: 10px;
    }

    .variant-group h4 {
        margin: 0;
    }

    /* State matrix */

    .state-group {
        display: grid;
        gap: 12px;
        margin-top: 18px;
    }

    .state-group h4 {
        margin: 0;
    }

    .state-row {
        display: grid;
        grid-template-columns: 72px repeat(3, minmax(0, 1fr));
        align-items: end;
        gap: 10px;
    }

    .state-name {
        align-self: center;
        font-size: 12px;
        font-weight: 600;
    }

    .state-item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 7px;
        min-width: 0;
    }

    .state-item > span {
        font-size: 11px;
        opacity: 0.7;
    }

    .state-item .btn {
        max-width: 100%;
    }

    /* Comparisons */

    .comparison {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .comparison-item {
        min-width: 0;
        padding: 16px;
        border: 1px solid var(--aui-color-border);
        border-radius: var(--aui-radius-surface);
    }

    .comparison-item h4 {
        margin: 0 0 14px;
    }

    /* Layout */

    .block-example {
        margin-top: 12px;
    }

    /* Composition */

    .scenario {
        padding: 20px;
        border: 1px solid var(--aui-color-border);
        border-radius: var(--aui-radius-surface);
    }

    .scenario h4 {
        margin: 0 0 8px;
        font-size: 16px;
        font-weight: 600;
    }

    .scenario p {
        margin: 0 0 18px;
        font-size: 13px;
        line-height: 1.5;
        opacity: 0.72;
    }

    .scenario-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
    }

    /* Responsive */

    @media (max-width: 900px) {
        .themes {
            grid-template-columns: 1fr;
        }

        .theme {
            padding: 20px;
        }
    }

    @media (max-width: 600px) {
        .state-row {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .state-name {
            grid-column: 1 / -1;
        }

        .comparison {
            grid-template-columns: 1fr;
        }
    }
</style>
