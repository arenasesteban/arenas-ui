---
import {
    IconAlertTriangle,
    IconCheck,
    IconMenu2,
    IconPlus,
    IconTrash,
    IconX,
} from '@tabler/icons-astro';

import '../styles/global.css';

const themes = [
    { id: 'light', title: 'Light theme' },
    { id: 'dark', title: 'Dark theme' },
] as const;

const roles = [
    { label: 'Primary', className: '' },
    { label: 'Secondary', className: 'btn-secondary' },
    { label: 'Success', className: 'btn-success' },
    { label: 'Warning', className: 'btn-warning' },
    { label: 'Error', className: 'btn-error' },
] as const;

const variants = [
    { label: 'Solid', className: '' },
    { label: 'Outline', className: 'btn-outline' },
    { label: 'Ghost', className: 'btn-ghost' },
    { label: 'Smooth', className: 'btn-smooth' },
] as const;

const sizes = [
    { label: 'Small', className: 'btn btn-sm' },
    { label: 'Medium', className: 'btn btn-md' },
    { label: 'Large', className: 'btn btn-lg' },
] as const;

const stateRoles = [
    { label: 'Primary', className: '' },
    { label: 'Success', className: 'btn-success' },
] as const;
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Button Review — Arenas UI</title>
    </head>

    <body>
        <main class="review">
            <header class="review-header">
                <h1>Arenas UI — Button Review</h1>
                <p>Visual validation · Variants, states, geometry and composition</p>
            </header>

            <div class="themes">
                {themes.map((theme) => (
                    <section class="theme" data-theme={theme.id}>
                        <h2>{theme.title}</h2>

                        <!-- Variants and semantic colors -->
                        <section class="review-section">
                            <h3>Variants & Semantic Colors</h3>

                            <div class="matrix-scroll">
                                <div class="matrix matrix--variants">
                                    <div class="matrix-row matrix-row--header">
                                        <span>Color</span>

                                        {variants.map((variant) => (
                                            <span>{variant.label}</span>
                                        ))}
                                    </div>

                                    {roles.map((role) => (
                                        <div class="matrix-row">
                                            <span class="matrix-label">{role.label}</span>

                                            {variants.map((variant) => (
                                                <div class="matrix-cell">
                                                    <button
                                                        type="button"
                                                        class={`btn ${role.className} ${variant.className}`.trim()}
                                                    >
                                                        Action
                                                    </button>
                                                </div>
                                            ))}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </section>

                        <!-- Sizes and shapes -->
                        <section class="review-section">
                            <h3>Sizes & Shapes</h3>

                            <div class="review-group">
                                <h4>Sizes</h4>

                                <div class="samples">
                                    {sizes.map((size) => (
                                        <button type="button" class={size.className}>
                                            {size.label}
                                        </button>
                                    ))}
                                </div>
                            </div>

                            <div class="review-group">
                                <h4>Shapes</h4>

                                <div class="samples">
                                    <button type="button" class="btn">
                                        Regular
                                    </button>

                                    <button type="button" class="btn btn-pill">
                                        Rounded
                                    </button>

                                    <button
                                        type="button"
                                        class="btn btn-square"
                                        aria-label="Abrir menú"
                                    >
                                        <IconMenu2 size={18} stroke={1.8} aria-hidden="true" />
                                    </button>

                                    <button
                                        type="button"
                                        class="btn btn-circle"
                                        aria-label="Cerrar"
                                    >
                                        <IconX size={18} stroke={1.8} aria-hidden="true" />
                                    </button>
                                </div>
                            </div>
                        </section>

                        <!-- States and loading -->
                        <section class="review-section">
                            <h3>States & Loading</h3>

                            <div class="matrix-scroll">
                                <div class="matrix matrix--states">
                                    <div class="matrix-row matrix-row--header">
                                        <span>Variant</span>
                                        <span>Enabled</span>
                                        <span>Disabled</span>
                                        <span>Processing</span>
                                    </div>

                                    {stateRoles.map((role) => (
                                        <div class="matrix-group">
                                            <h4>{role.label}</h4>

                                            {variants.map((variant) => {
                                                const buttonClass =
                                                    `btn ${role.className} ${variant.className}`.trim();

                                                return (
                                                    <div class="matrix-row">
                                                        <span class="matrix-label">
                                                            {variant.label}
                                                        </span>

                                                        <div class="matrix-cell">
                                                            <button
                                                                type="button"
                                                                class={buttonClass}
                                                            >
                                                                Action
                                                            </button>
                                                        </div>

                                                        <div class="matrix-cell">
                                                            <button
                                                                type="button"
                                                                class={buttonClass}
                                                                disabled
                                                            >
                                                                Action
                                                            </button>
                                                        </div>

                                                        <div class="matrix-cell">
                                                            <button
                                                                type="button"
                                                                class={buttonClass}
                                                                disabled
                                                                aria-busy="true"
                                                            >
                                                                <span
                                                                    class="loading loading-spinner"
                                                                    aria-hidden="true"
                                                                ></span>
                                                                Action
                                                            </button>
                                                        </div>
                                                    </div>
                                                );
                                            })}
                                        </div>
                                    ))}
                                </div>
                            </div>

                            <div class="supporting-example">
                                <span class="supporting-example-label">
                                    Standalone loading indicator
                                </span>

                                <span
                                    class="loading loading-spinner"
                                    role="status"
                                    aria-label="Cargando"
                                ></span>
                            </div>
                        </section>

                        <!-- Iconography -->
                        <section class="review-section">
                            <h3>Iconography</h3>

                            <div class="samples">
                                <button type="button" class="btn btn-success">
                                    <IconCheck size={18} stroke={1.8} aria-hidden="true" />
                                    Confirmar
                                </button>

                                <button type="button" class="btn btn-warning btn-smooth">
                                    <IconAlertTriangle size={18} stroke={1.8} aria-hidden="true" />
                                    Advertencia
                                </button>

                                <button type="button" class="btn btn-error btn-outline">
                                    <IconTrash size={18} stroke={1.8} aria-hidden="true" />
                                    Eliminar
                                </button>

                                <button type="button" class="btn btn-pill">
                                    <IconPlus size={18} stroke={1.8} aria-hidden="true" />
                                    Agregar
                                </button>
                            </div>
                        </section>

                        <!-- Customization -->
                        <section class="review-section">
                            <h3>Customization</h3>

                            <div class="review-group">
                                <h4>Control radius</h4>

                                <div class="comparison">
                                    <div class="comparison-item">
                                        <span class="comparison-label">Theme default</span>

                                        <button type="button" class="btn">
                                            Default
                                        </button>
                                    </div>

                                    <div class="comparison-item">
                                        <span class="comparison-label">Token override</span>

                                        <button
                                            type="button"
                                            class="btn"
                                            style="--aui-radius-control: 0.5rem"
                                        >
                                            Custom radius
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="review-group">
                                <h4>Typography inheritance</h4>

                                <div class="comparison">
                                    <div
                                        class="comparison-item"
                                        style="font-family: system-ui, sans-serif"
                                    >
                                        <span class="comparison-label">System UI</span>

                                        <button type="button" class="btn">
                                            Continue
                                        </button>
                                    </div>

                                    <div
                                        class="comparison-item"
                                        style="font-family: Arial, sans-serif"
                                    >
                                        <span class="comparison-label">Arial</span>

                                        <button type="button" class="btn">
                                            Continue
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="review-group">
                                <h4>Utilities & Layout</h4>

                                <div class="samples">
                                    <button
                                        type="button"
                                        class="btn bg-blue-800 text-white px-8 rounded-none"
                                    >
                                        Utility override
                                    </button>

                                    <a href="#destination" class="btn btn-outline">
                                        Styled link
                                    </a>
                                </div>

                                <div class="block-example">
                                    <button type="button" class="btn btn-block">
                                        Block button
                                    </button>
                                </div>
                            </div>
                        </section>

                        <!-- Composition -->
                        <section class="review-section">
                            <h3>Composition</h3>

                            <div class="review-group">
                                <h4>Action hierarchy</h4>

                                <div class="scenario">
                                    <p>¿Guardar los cambios?</p>

                                    <div class="scenario-actions">
                                        <button type="button" class="btn btn-secondary">
                                            Cancelar
                                        </button>

                                        <button type="button" class="btn">
                                            Guardar cambios
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="review-group">
                                <h4>Semantic actions</h4>

                                <div class="scenario">
                                    <p>Gestión de elementos</p>

                                    <div class="scenario-actions">
                                        <button type="button" class="btn">
                                            Editar
                                        </button>

                                        <button type="button" class="btn btn-success btn-smooth">
                                            <IconCheck size={18} stroke={1.8} aria-hidden="true" />
                                            Confirmar
                                        </button>

                                        <button type="button" class="btn btn-error btn-ghost">
                                            <IconTrash size={18} stroke={1.8} aria-hidden="true" />
                                            Eliminar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </section>
                ))}
            </div>

            <div id="destination"></div>
        </main>
    </body>
</html>

<style>
    body {
        margin: 0;
        font-family: system-ui, sans-serif;
        background: #f4f4f5;
    }

    /* Page layout */

    .review {
        max-width: 1440px;
        margin: 0 auto;
        padding: 32px 20px;
    }

    .review-header {
        margin-bottom: 28px;
    }

    .review-header h1 {
        margin: 0 0 8px;
        font-size: 28px;
        font-weight: 700;
    }

    .review-header p {
        margin: 0;
        color: #52525b;
        font-size: 14px;
    }

    /* Theme panels */

    .themes {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .theme {
        display: flex;
        flex-direction: column;
        gap: 30px;
        min-width: 0;
        padding: 28px;
        border: 1px solid var(--aui-color-border);
        border-radius: var(--aui-radius-surface);
        background: var(--aui-color-surface);
        color: var(--aui-color-text);
    }

    .theme h2 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        line-height: 1.3;
    }

    /* Section hierarchy */

    .review-section {
        display: grid;
        gap: 18px;
        min-width: 0;
    }

    .review-section + .review-section {
        padding-top: 28px;
        border-top: 1px solid var(--aui-color-border);
    }

    .review-section h3 {
        margin: 0;
        font-size: 16px;
        font-weight: 650;
        line-height: 1.4;
    }

    .review-section h4 {
        margin: 0;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.4;
    }

    .review-group {
        display: grid;
        gap: 12px;
        min-width: 0;
    }

    .review-group + .review-group {
        padding-top: 8px;
    }

    .samples {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
    }

    /* Shared comparison matrices */

    .matrix-scroll {
        width: 100%;
        min-width: 0;
        overflow-x: auto;
    }

    .matrix {
        display: grid;
        gap: 10px;
        min-width: var(--matrix-min-width);
    }

    .matrix--variants {
        --matrix-columns: 88px repeat(4, minmax(105px, 1fr));
        --matrix-min-width: 570px;
    }

    .matrix--states {
        --matrix-columns: 88px repeat(3, minmax(115px, 1fr));
        --matrix-min-width: 500px;
    }

    .matrix-row {
        display: grid;
        grid-template-columns: var(--matrix-columns);
        align-items: center;
        gap: 12px;
        min-height: 42px;
    }

    .matrix-row--header {
        min-height: auto;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--aui-color-border);
    }

    .matrix-row--header span {
        font-size: 11px;
        font-weight: 600;
        line-height: 1.4;
        letter-spacing: 0.025em;
        opacity: 0.7;
    }

    .matrix-row--header span:not(:first-child) {
        text-align: center;
    }

    .matrix-label {
        font-size: 12px;
        font-weight: 500;
        line-height: 1.4;
        opacity: 0.8;
    }

    .matrix-cell {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        min-height: 42px;
    }

    .matrix-cell .btn {
        max-width: 100%;
    }

    /* State groups */

    .matrix-group {
        display: grid;
        gap: 10px;
    }

    .matrix-group h4 {
        margin: 0 0 2px;
    }

    .matrix-group + .matrix-group {
        padding-top: 18px;
        border-top: 1px solid var(--aui-color-border);
    }

    .supporting-example {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--aui-color-border);
    }

    .supporting-example-label {
        font-size: 12px;
        font-weight: 500;
        opacity: 0.7;
    }

    /* Customization comparisons */

    .comparison {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .comparison-item {
        display: grid;
        align-content: start;
        justify-items: start;
        gap: 14px;
        min-width: 0;
        padding: 16px;
        border: 1px solid var(--aui-color-border);
        border-radius: var(--aui-radius-surface);
    }

    .comparison-label {
        font-size: 12px;
        font-weight: 500;
        line-height: 1.4;
        opacity: 0.75;
    }

    .block-example {
        margin-top: 4px;
    }

    /* Composition */

    .scenario {
        display: grid;
        gap: 18px;
        padding: 20px;
        border: 1px solid var(--aui-color-border);
        border-radius: var(--aui-radius-surface);
    }

    .scenario p {
        margin: 0;
        font-size: 13px;
        line-height: 1.5;
    }

    .scenario-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
    }

    /* Responsive */

    @media (max-width: 1100px) {
        .themes {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .review {
            padding: 24px 12px;
        }

        .theme {
            padding: 20px;
        }

        .review-section + .review-section {
            padding-top: 24px;
        }

        .comparison {
            grid-template-columns: 1fr;
        }
    }
</style>
