---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Arenas UI — Plugin Playground</title>
    </head>
    <body class="min-h-screen bg-stone-50 px-8 py-12 text-stone-900">
        <main class="mx-auto max-w-2xl">
            <h1 class="text-3xl font-bold">Arenas UI</h1>

            <p class="mt-3 text-stone-600">Tailwind CSS v4 plugin integration playground.</p>

            <section class="aui-plugin-check mt-8 rounded-lg border border-stone-300 p-6">
                <h2 class="text-xl font-semibold">Plugin integration check</h2>

                <p class="mt-3">The dashed outline is registered by Arenas UI.</p>
            </section>

            <p class="mt-8 text-sm text-stone-500">
                Tailwind utilities and the Arenas UI plugin are compiled together.
            </p>
        </main>
    </body>
</html>
