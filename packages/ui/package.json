{
    "name": "@arenasesteban/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "peerDependencies": {
        "tailwindcss": "^4.0.0"
    },
    "scripts": {
        "build": "tsc --project tsconfig.json",
        "typecheck": "tsc --noEmit --project tsconfig.json",
        "test:compile": "tailwindcss -i ./tests/fixtures/plugin.css -o ./tests/fixtures/plugin.generated.css",
        "test:plugin": "node --test ./tests/contracts/plugin.test.ts",
        "test:button": "node --test ./tests/contracts/button.test.ts",
        "test:contracts": "pnpm build && pnpm test:compile && pnpm test:plugin && pnpm test:button"
    },
    "devDependencies": {
        "@tailwindcss/cli": "4.3.5",
        "@types/node": "^26.6.6",
        "tailwindcss": "^4.3.5"
    }
}
